diff --git a/tools/uzem/avr8.h b/tools/uzem/avr8.h
index 45b643c..35db090 100644
--- a/tools/uzem/avr8.h
+++ b/tools/uzem/avr8.h
@@ -43,9 +43,36 @@ THE SOFTWARE.
     #include <sys/mmap.h> // Unix memory mapped I/O
 #endif
 
+#ifdef CHIMERA_CORE
+// Chimera: the core has no window, sound device or host keyboard of its own;
+// Chimera's frontend has them, and SDL is not built. SDL's types are named
+// here so that the machine's structure keeps its shape; the picture, the
+// sound and the controls go to and come from the core
+// (waterbox/cinterface.cpp) through the names below.
+typedef uint8_t Uint8;
+typedef struct SDL_Window SDL_Window;
+typedef struct SDL_Renderer SDL_Renderer;
+typedef struct SDL_Surface SDL_Surface;
+typedef struct SDL_Texture SDL_Texture;
+typedef struct SDL_Joystick SDL_Joystick;
+typedef union SDL_Event SDL_Event;
+typedef enum { SDL_FLIP_NONE = 0, SDL_FLIP_HORIZONTAL = 1, SDL_FLIP_VERTICAL = 2 } SDL_RendererFlip;
+struct avr8;
+// where the line being drawn goes: 720 pixels a line, 224 lines
+extern uint32_t *chimera_video;
+// the program wrote a sample to the sound output (OCR2A)
+void chimera_sound_level(uint8_t value);
+// the 224th line was drawn: the frame is over
+void chimera_frame_end(avr8 *machine);
+// how many times the program latched the controllers: its reads of them
+extern int chimera_input_reads;
+// the machine stopped: an instruction it does not know
+void chimera_halt(int errcode);
+#else
 // If you're building from the command line or on a non-MS compiler you'll need
 // -lSDL or somesuch.
 #include <SDL2/SDL.h>
+#endif
 #if defined (_MSC_VER)
 	#pragma comment(lib, "SDL.lib")
 	#pragma comment(lib, "SDLmain.lib")
