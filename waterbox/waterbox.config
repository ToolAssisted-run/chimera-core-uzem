{
 "coreName": "Uzem",
 "systemId": "UZE",
 "systemNames": {
  "UZE": "Uzebox"
 },
 "author": "David Etherton, Eric Anderton, Alec Bourque (Uze), Filipe Rinaldi, Sandor Zsuga (Jubatian), Matt Pandina (Artcfox) and the Uzebox authors; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-uzem",
 "romFile": "game",
 "deterministic": true,
 "memoryLayoutMiB": [
  16,
  4,
  4,
  8,
  64
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. An Uzebox has 4 KB of memory, 2 KB of EEPROM and 64 KB of flash; uzem keeps the program decoded beside it, about 1 MB in all.",
 "video": {
  "_comment": "uzem's picture: 720 pixels by 224 lines, every second processor cycle of a line, as upstream's window shows it; upstream shows it at 630x448, the shape of the television picture. The frame rate is the console's own: 28,636,360 cycles a second, 1820 a line, 262 lines a frame, 60.05 frames a second.",
  "width": 720,
  "height": 224,
  "virtualWidth": 630,
  "virtualHeight": 448,
  "vsyncNumerator": 3579545,
  "vsyncDenominator": 59605,
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "The Uzebox's sound is one 8-bit level the kernel writes once a line: 15,734 samples a second (one a line), 262 a frame. The same level is in both channels.",
  "rate": 15734,
  "samplesPerFrame": 512,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "p1Controller",
   "display": "setting.p1controller",
   "type": "enum",
   "options": [
    "auto",
    "gamepad",
    "mouse"
   ],
   "default": "auto",
   "description": "setting.p1controller.about"
  },
  {
   "name": "randomSeed",
   "display": "setting.randomseed",
   "type": "int",
   "min": 0,
   "max": 2147483647,
   "default": 0,
   "description": "setting.randomseed.about"
  }
 ],
 "firmware": [],
 "extensions": {
  ".uze": "UZE",
  ".hex": "UZE"
 },
 "input": {
  "name": "Uzebox Controls",
  "picture": "pictures/snes-controller.png",
  "_comment": "Two SNES gamepads (Up, Down, Left, Right, Select, Start, Y, B, X, A, L, R, listed as Chimera's SNES core lists them; the pad sends them in another order, which the core keeps). A SNES mouse can take the first gamepad's place (the P1 Controller setting): Mouse Left and Mouse Right are its buttons, and Mouse Move X and Y how far it moves in a frame, -127 to 127. Power is the console's soft power switch. The keys are the Uzebox keyboard's, a PC keyboard read through the second controller port; a game hears them once it starts the keyboard.",
